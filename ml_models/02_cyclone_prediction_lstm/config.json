{
  "model_name": "Bi-LSTM Temporal Attention Cyclone Forecaster",
  "version": "1.0.0",
  "architecture": "Bidirectional-LSTM-Attention",
  "sequence_length": 6,
  "time_step_interval_hours": 3,
  "historical_window_hours": 18,
  "forecast_horizon_hours": 6,
  "input_features": [
    "LAT",
    "LON",
    "WIND_KTS",
    "PRESSURE_HPA",
    "STORM_SPEED",
    "STORM_DIR_SIN",
    "STORM_DIR_COS",
    "WIND_CHANGE",
    "PRESSURE_CHANGE",
    "LAT_CHANGE",
    "LON_CHANGE",
    "DIST2LAND",
    "MONTH_SIN",
    "MONTH_COS",
    "HOUR_SIN",
    "HOUR_COS",
    "YEAR"
  ],
  "engineered_physics_features": [
    "CORIOLIS_F",
    "PRESSURE_DEFICIT_HPA"
  ],
  "classes": ["Weak", "Moderate", "Strong"],
  "metrics": {
    "classification_accuracy": 0.9328,
    "macro_f1": 0.9274,
    "mean_distance_error_km": 58.42,
    "median_distance_error_km": 46.10,
    "r2_latitude": 0.9961,
    "r2_longitude": 0.9958,
    "r2_wind_speed": 0.9712,
    "r2_pressure": 0.9680
  }
}
